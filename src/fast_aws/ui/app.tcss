.hidden {
    display: none;
}

/* ---- transparent base (terminal background shows through) ------------- */
Screen, ModalScreen, #layout, #main, Footer, Footer > *, FooterKey, FooterLabel,
DataTable, DataTable > .datatable--header, ListView, ListItem, Input, VerticalScroll {
    background: transparent;
}
Screen {
    background: ansi_default;
}
ModalScreen {
    background: transparent;
}


/* ---- top bar ---------------------------------------------------------- */
#topbar {
    height: 3;
    dock: top;
    background: transparent;
    border: round ansi_bright_black;
    color: $foreground-muted;
    padding: 0 1;
}

/* ---- layout ------------------------------------------------------------ */
#layout {
    height: 1fr;
}
ListView > ListItem {
    padding: 0 1;
    height: 1;
}
ListView > ListItem > Label {
    padding: 0 1;
}

#main {
    height: 1fr;
}
#main, #inspector {
    border: round ansi_bright_black;
    border-title-color: $text-primary;
    border-title-style: bold;
}
#main:focus-within, #inspector:focus-within {
    border: round $primary;
}

#filter-row {
    height: 3;
    background: transparent;
    border: round ansi_bright_black;
}
#filter-label {
    padding: 0 1;
    width: 8;
    content-align: center middle;
    color: $text-primary;
    text-style: bold;
}
#filter {
    border: none;
    background: transparent;
}

DataTable {
    height: 1fr;
    border: none;
}
DataTable:focus {
    border: none;
}

#status {
    height: 1;
    padding: 0 1;
    color: $foreground-muted;
    background: transparent;
}
#status.error {
    color: $text-error;
}
#status.ok {
    color: $text-success;
}

/* ---- inspector --------------------------------------------------------- */
#inspector {
    width: 32%;
    min-width: 34;
    max-width: 60;
    background: transparent;
}
BrowseScreen.narrow-hide #inspector {
    display: none;
}
#insp-kind {
    color: $foreground-muted;
    padding: 0 1;
}
#insp-detail {
    padding: 1;
    height: auto;
    margin: 0 1 0 0;
}
.insp-section {
    color: $foreground;
    text-style: bold;
    padding: 1 1 0 1;
}
#insp-links, #insp-actions {
    padding: 0 1;
}

/* ---- modals ------------------------------------------------------------ */
ModalScreen {
    align: center middle;
}
.dialog {
    width: 72;
    max-width: 92%;
    height: auto;
    max-height: 90%;
    background: $background;
    border: round $primary;
    padding: 1 2;
}
.dialog {
    border-title-color: $text-primary;
    border-title-style: bold;
    border-subtitle-color: $foreground-muted;
}
.dialog.small {
    width: 46;
}
.dialog-title {
    text-style: bold;
    color: $text-primary;
    padding: 0 0 1 0;
}
.dialog-list {
    height: 1fr;
    margin: 1 0 0 0;
}
.dialog-note {
    color: $foreground-muted;
    padding: 1 0 0 0;
}
.dialog-error {
    color: $text-error;
    padding: 1 0 0 0;
}

/* ---- pickers ----------------------------------------------------------- */
#profile-dialog, #service-dialog {
    width: 88;
}
#profiles, #services-pick {
    margin: 1 0 0 0;
    height: auto;
    max-height: 24;
}
#profiles > ListItem.current, #services-pick > ListItem.current {
    color: $text-primary;
}
#profile-status {
    padding: 1 0 0 0;
}

#palette-input {
    margin: 0 0 1 0;
    border: round $border;
}

Button {
    margin: 1 1 0 0;
}

#result-scroll {
    height: 1fr;
}
#result-body {
    height: auto;
    padding: 1;
}

RichLog {
    background: transparent;
    border: round $border;
    height: 1fr;
    padding: 0 1;
}

#tail-status {
    color: $foreground-muted;
    padding: 0 1 1 0;
}

LoadingIndicator {
    align: center middle;
    height: 1fr;
}

/* ---- dim the page behind a modal --------------------------------------- */
Screen.dimmed * {
    text-style: dim;
}
Screen.dimmed #main, Screen.dimmed #inspector, Screen.dimmed #topbar {
    border: round ansi_bright_black;
}
Screen.dimmed DataTable > .datatable--cursor {
    background: transparent;
}
