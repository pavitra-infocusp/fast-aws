.hidden {
    display: none;
}

/* ---- top bar ---------------------------------------------------------- */
#topbar {
    height: 2;
    dock: top;
    background: $panel;
    color: $foreground-muted;
    padding: 0 1;
}

/* ---- layout ------------------------------------------------------------ */
#layout {
    height: 1fr;
}
ListView > ListItem {
    padding: 0 1;
    height: 1;
}
ListView > ListItem > Label {
    padding: 0 1;
}

#main {
    height: 1fr;
}

#breadcrumb {
    height: 1;
    padding: 0 1;
    color: $foreground-muted;
    background: $panel;
}
#breadcrumb .crumb-sep {
    color: $foreground-disabled;
}

#filter-row {
    height: 3;
    background: $panel;
    border-bottom: solid $border-blurred;
}
#filter-label {
    padding: 0 1;
    width: 8;
    content-align: center middle;
    color: $text-primary;
    text-style: bold;
}
#filter {
    border: none;
    background: transparent;
}

DataTable {
    height: 1fr;
    border-bottom: solid $border-blurred;
}
DataTable:focus {
    border: none;
}

#status {
    height: 1;
    padding: 0 1;
    color: $foreground-muted;
    background: $panel;
}
#status.error {
    color: $text-error;
}
#status.ok {
    color: $text-success;
}

/* ---- inspector --------------------------------------------------------- */
#inspector {
    width: 40;
    background: $panel;
    border-left: solid $border-blurred;
}
#insp-title {
    text-style: bold;
    color: $text-primary;
    padding: 1 1 0 1;
}
#insp-kind {
    color: $foreground-muted;
    padding: 0 1;
}
#insp-note {
    color: $foreground-disabled;
    padding: 0 1;
}
#insp-detail {
    padding: 1;
    height: auto;
    margin: 0 1 0 0;
}
.insp-section {
    color: $foreground;
    text-style: bold;
    padding: 1 1 0 1;
}
#insp-links, #insp-actions {
    padding: 0 1;
}

/* ---- modals ------------------------------------------------------------ */
ModalScreen {
    align: center middle;
}
.dialog {
    width: 72;
    max-width: 92%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: tall $border;
    padding: 1 2;
}
.dialog.small {
    width: 46;
}
.dialog-title {
    text-style: bold;
    color: $text-primary;
    padding: 0 0 1 0;
}
.dialog-list {
    height: 1fr;
    margin: 1 0 0 0;
}
.dialog-note {
    color: $foreground-muted;
    padding: 1 0 0 0;
}
.dialog-error {
    color: $text-error;
    padding: 1 0 0 0;
}

/* ---- pickers ----------------------------------------------------------- */
#profile-dialog, #service-dialog {
    width: 64;
}
#profiles, #services-pick {
    margin: 1 0 0 0;
    height: auto;
    max-height: 24;
}
#profiles > ListItem.current, #services-pick > ListItem.current {
    color: $text-primary;
}
#profile-status {
    padding: 1 0 0 0;
}

#palette-input {
    margin: 0 0 1 0;
    border: round $border;
}

Button {
    margin: 1 1 0 0;
}

#result-scroll {
    height: 1fr;
}
#result-body {
    height: auto;
    padding: 1;
}

RichLog {
    background: $background;
    border: round $border;
    height: 1fr;
    padding: 0 1;
}

#tail-status {
    color: $foreground-muted;
    padding: 0 1 1 0;
}

LoadingIndicator {
    align: center middle;
    height: 1fr;
}
